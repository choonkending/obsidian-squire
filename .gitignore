# vscode
.vscode 

# Intellij
*.iml
.idea

# npm
node_modules

# Don't include the compiled main.js file in the repo.
# They should be uploaded to GitHub releases instead.
main.js

# Exclude sourcemaps
*.map

# obsidian
data.json

# Exclude macOS Finder (System Explorer) View States
.DS_Store

# ONNX Runtime WASM files (copied from node_modules at build time)
ort-wasm-simd-threaded*

# DiskCache artifact from Transformers.js
.cache/

# Embedding index (generated at runtime)
squire-embedding-index.json
